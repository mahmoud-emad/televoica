# Example environment variables for Televoica Robot
#
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Get a bot token from @BotFather on Telegram
# 3. Replace 'your_bot_token_here' with your actual token
# 4. Adjust other settings as needed
#
# SECURITY NOTE:
# - Never commit .env to git (it's in .gitignore)
# - Keep your bot token secret
# - For production, use GitHub Secrets or environment variables

# ============================================================================
# REQUIRED: Telegram Bot Configuration
# ============================================================================

# Your Telegram bot token from @BotFather
# Get it by: 1) Open @BotFather, 2) Send /newbot, 3) Follow instructions
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Optional: Restrict bot to specific users (comma-separated user IDs)
# Leave empty to allow all users
# Get your user ID from @userinfobot
TELEGRAM_ALLOWED_USERS=

# Maximum file size for audio uploads (in MB)
# Note: Telegram's Bot API caps downloads at 20 MB. Voice notes are tiny
# (~16 kbps Opus, so 1 hour ~= 7 MB), but forwarded mp3/m4a files can hit
# the cap quickly. Keep <= 20 unless you're running a local Bot API server.
TELEGRAM_MAX_FILE_SIZE_MB=20

# ============================================================================
# OPTIONAL: Application Mode
# ============================================================================

# Enable Telegram bot mode (true) or standalone mode (false)
STT_TELEGRAM_BOT=true

# ============================================================================
# OPTIONAL: Speech-to-Text Provider
# ============================================================================
# STT provider to use
# Options: faster_whisper (default, most accurate), whisper (legacy), google_cloud
STT_PROVIDER=faster_whisper

# ============================================================================
# OPTIONAL: Whisper Configuration
# ============================================================================
# Model: large-v3 (most accurate, default), large-v3-turbo (~6x faster, slightly
# less accurate), medium, small, base, tiny.
# large-v3 needs ~3 GB RAM on CPU (int8) or ~5 GB VRAM on GPU (float16).
STT_WHISPER_MODEL=large-v3

# Device: auto (default; uses CUDA if available), cpu, cuda
STT_WHISPER_DEVICE=auto

# Compute type (faster_whisper): auto (int8 on CPU, float16 on GPU), int8, float16, float32
STT_WHISPER_COMPUTE_TYPE=auto

# Language code. SET THIS if you always speak one language: auto-detection is
# the #1 cause of wrong/translated output, especially for Arabic.
# Examples: en, ar, es, fr, de. Leave empty for auto-detection.
STT_WHISPER_LANGUAGE=

# Vocabulary hint (faster_whisper): names, technical terms, or a sample sentence
# in the style/spelling you want. Example: "Televoica, Telegram, Kubernetes"
STT_WHISPER_INITIAL_PROMPT=

# Beam search width (faster_whisper). Higher = more accurate but slower.
STT_WHISPER_BEAM_SIZE=5

# Skip silence/noise with voice-activity detection (faster_whisper).
STT_WHISPER_VAD_FILTER=true

# ============================================================================
# OPTIONAL: Google Cloud Speech-to-Text Configuration
# ============================================================================

# Uncomment these if using Google Cloud STT provider
# Path to Google Cloud credentials JSON file
# STT_GOOGLE_CREDENTIALS_PATH=/path/to/credentials.json

# Language code for Google Cloud STT
# STT_GOOGLE_LANGUAGE_CODE=en-US

# ============================================================================
# OPTIONAL: Release announcements
# ============================================================================
# After an update, message every known chat a short summary of the release
# (from release_notes/<version>.md) with a link to the full notes.
STT_ANNOUNCE_RELEASES=true

# Persistent state (known chats, last announced release). Keep it on a volume.
# STT_DATA_DIR=~/.televoica

# Repository used for the release-notes link
# STT_REPO_URL=https://github.com/Mahmoud-Emad/televoica

# ============================================================================
# OPTIONAL: Logging and Storage
# ============================================================================

# Logging level
# Options: DEBUG (verbose), INFO (recommended), WARNING, ERROR
STT_LOG_LEVEL=INFO

# Temporary directory for storing downloaded audio files
STT_TEMP_DIR=/tmp/televoica

